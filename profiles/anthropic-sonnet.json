{
    "name": "anthropic-sonnet",
    "tier3": {
        "wire": "anthropic-messages",
        "model": "claude-sonnet-5-5",
        "apiKey": {
            "env": "ANTHROPIC_API_KEY"
        },
        "capabilities": [
            "tools",
            "json"
        ],
        "maxTokens": 8192
    },
    "gateway": {
        "host": "laptop"
    },
    "factory": {
        "runner": "local"
    }
}
