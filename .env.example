# Copy to .env (ignored by git). Node reads it: npm run tier3 -- --provider model --profile profiles/<name>.json
# One key per wire; the profile's tier3.apiKey.env names which one it reads.
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
NEBIUS_API_KEY=
OPENAI_API_KEY=
# Optional. Defaults to profiles/web-search.json (direct Brave Search).
# Select a hosted or legacy profile to use the same web.search MCP contract.
# WEB_SEARCH_PROFILE=profiles/web-search-openai.json
# WEB_SEARCH_PROFILE=profiles/web-search-anthropic.json
# WEB_SEARCH_PROFILE=profiles/web-search-google.json
# Google Custom Search is legacy and also requires these two values.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# The speech slot's engine (profiles/voice.json names which variable it reads).
ELEVENLABS_API_KEY=
# Optional. Where Fusion 360's MCP server (its add-in) listens; the fusion slot relays it. Defaults to http://127.0.0.1:27182/mcp.
# The fusion slot's connect {url} changes it while the server runs. FUSION_MCP_TIMEOUT_MS bounds the probe (4000 by default).
# FUSION_MCP_URL=http://127.0.0.1:27182/mcp
