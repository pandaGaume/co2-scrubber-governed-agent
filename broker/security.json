{
    "description": "Who may call what, where (2026-10-08, mcp-broker 1.8.1 development authorization). On when MCP_BROKER_SECURITY_FILE=broker/security.json is set (npm run broker:tokens writes it into .env with the tokens). Every client presents the token of its role (harness/lib/broker-auth.ts); a tool no line below names is mcp.tools.call. The agent may act on the scrubber's speed, never power it off, lower its protection, feed it a CO2 reading, authorise, register, rewrite wording or stop its own loop: the board refuses below that, the crew's switch sits above.",
    "auth": {
        "dev": {
            "callers": [
                { "id": "operator", "tokenEnv": "BROKER_TOKEN_OPERATOR", "user": "commander", "groups": ["operators"] },
                { "id": "station", "tokenEnv": "BROKER_TOKEN_STATION", "service": "station", "groups": ["system"] },
                { "id": "agent", "tokenEnv": "BROKER_TOKEN_AGENT", "service": "tier3", "groups": ["agents"] },
                { "id": "factory", "tokenEnv": "BROKER_TOKEN_FACTORY", "service": "factory", "groups": ["factories"] },
                { "id": "monitor", "tokenEnv": "BROKER_TOKEN_MONITOR", "user": "medical-monitor", "groups": ["monitors"] }
            ],
            "networks": ["lan"]
        },
        "slotResources": {
            "scrubber": "/habitat/lab/eclss/scrubber-1"
        },
        "toolCapabilities": {
            "grammar_set": "mcp.tools.grammar",
            "grammar_delete": "mcp.tools.grammar",
            "grammar_import": "mcp.tools.grammar"
        },
        "providerToolCapabilities": {
            "/habitat/lab/eclss/scrubber-1": {
                "motor.set_speed": "mcp.tools.actuate",
                "scrubber.set_profile": "mcp.tools.actuate",
                "scrubber.power": "mcp.tools.power",
                "scrubber.set_min_flow": "mcp.tools.protect",
                "debug.set_co2": "mcp.tools.sense"
            },
            "/station": {
                "answer": "mcp.tools.authorise",
                "commissioning_authorise": "mcp.tools.authorise",
                "commissioning_reopen": "mcp.tools.authorise",
                "questions_policy": "mcp.tools.authorise",
                "registry_register": "mcp.tools.register",
                "registry_report": "mcp.tools.register",
                "register_artifact": "mcp.tools.register",
                "diagnostic_load_model": "mcp.tools.register"
            },
            "/library": {
                "sign": "mcp.tools.authorise"
            },
            "/biomed": {
                "alarm_clear": "mcp.tools.authorise"
            },
            "/agent": {
                "reset": "mcp.tools.control",
                "stop": "mcp.tools.control"
            }
        },
        "roles": {
            "everything": { "capabilities": ["*"] },
            "client": { "capabilities": ["mcp.tools.list", "mcp.tools.call", "mcp.resources.read", "mcp.prompts.read", "mcp.completion.use"] },
            "actuator": { "inherits": ["client"], "capabilities": ["mcp.tools.actuate"] },
            "broker-reader": { "capabilities": ["broker.providers.read"] }
        },
        "assignments": [
            { "id": "operator-everything", "subject": "group:operators", "role": "everything", "resource": "/**" },
            { "id": "operator-broker", "subject": "group:operators", "role": "everything", "resource": "/_system/**" },
            { "id": "station-everything", "subject": "group:system", "role": "everything", "resource": "/**" },
            { "id": "station-broker", "subject": "group:system", "role": "broker-reader", "resource": "/_system/broker" },
            { "id": "agent-habitat", "subject": "group:agents", "role": "actuator", "resource": "/**" },
            { "id": "agent-broker", "subject": "group:agents", "role": "broker-reader", "resource": "/_system/broker" },
            { "id": "factory-workshop", "subject": "group:factories", "role": "client", "resource": "/**" },
            { "id": "factory-broker", "subject": "group:factories", "role": "broker-reader", "resource": "/_system/broker" },
            { "id": "monitor-read", "subject": "group:monitors", "role": "client", "resource": "/**" }
        ],
        "denies": [
            { "id": "agent-never-power-protect-sense", "subject": "group:agents", "capabilities": ["mcp.tools.power", "mcp.tools.protect", "mcp.tools.sense", "mcp.tools.authorise", "mcp.tools.register", "mcp.tools.grammar", "mcp.tools.control"], "resource": "/**" },
            { "id": "factory-never-the-board", "subject": "group:factories", "capabilities": ["mcp.tools.actuate", "mcp.tools.power", "mcp.tools.protect", "mcp.tools.sense", "mcp.tools.authorise", "mcp.tools.register", "mcp.tools.grammar", "mcp.tools.control"], "resource": "/**" },
            { "id": "monitor-commands-nothing", "subject": "group:monitors", "capabilities": ["mcp.tools.actuate", "mcp.tools.power", "mcp.tools.protect", "mcp.tools.sense", "mcp.tools.authorise", "mcp.tools.register", "mcp.tools.grammar", "mcp.tools.control"], "resource": "/**" }
        ],
        "audit": { "logAllowed": false }
    }
}
