{
    "name": "co2-scrubber-governed-agent",
    "version": "0.1.0",
    "private": true,
    "description": "A CO2 scrubber, a crew, an agent, and an MCP broker between them: a governed agent-to-hardware demo on the SpikyPanda substrate.",
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/pandaGaume/co2-scrubber-governed-agent.git"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && node dist/scripts/build-agent-page.js",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "server": "node --env-file-if-exists=.env dist/slots/run-all.js",
        "biomed:start": "node dist/scripts/biomed-session.js start",
        "biomed:stop": "node dist/scripts/biomed-session.js stop",
        "biomed:state": "node dist/scripts/biomed-session.js state",
        "biomed:scan": "python scripts/polar-h10-bridge.py --scan",
        "biomed:strap": "python scripts/polar-h10-bridge.py --self-test",
        "slots": "node --env-file-if-exists=.env dist/slots/run-all.js --no-broker",
        "test": "node --test \"dist/tests/**/*.test.js\"",
        "job": "spikypanda-job",
        "chain": "spikypanda-job specs/rs385-drive.json && spikypanda-job specs/scrubber-health-twin.json && spikypanda-job specs/scrubber-health-eval.json",
        "twin:build": "node dist/scripts/build-cabin-graph.js",
        "twin:parity": "node dist/scripts/twin-parity.js",
        "twin:draw": "python scripts/draw-cabin-graph.py",
        "tier3": "node --env-file-if-exists=.env dist/tier3/run.js",
        "image": "docker build -f docker/Dockerfile -t ghcr.io/pandagaume/co2-scrubber-factory:0.1.0 .",
        "agent:build": "node dist/scripts/build-agent-graph.js",
        "agent:page": "node dist/scripts/build-agent-page.js",
        "substrate:vendor": "node scripts/vendor-substrate.mjs"
    },
    "dependencies": {
        "@cyanmycelium/mcp-broker": "^1.3.4",
        "@cyanmycelium/mcp-broker-provider": "^0.2.0",
        "@cyanmycelium/mcp-core": "^1.2.1",
        "@spiky-panda/core": "file:vendor/spiky-panda-core-1.0.1.tgz",
        "@spiky-panda/factory": "file:vendor/spiky-panda-factory-0.1.1.tgz",
        "@spiky-panda/harness": "file:vendor/spiky-panda-harness-0.1.1.tgz",
        "@spiky-panda/mcp": "file:vendor/spiky-panda-mcp-0.1.2.tgz",
        "@spiky-panda/nodeeditor": "file:vendor/spiky-panda-nodeeditor-0.1.1.tgz",
        "@spiky-panda/onnx": "file:vendor/spiky-panda-onnx-0.1.1.tgz",
        "@spiky-panda/plugin-control": "file:vendor/spiky-panda-plugin-control-0.1.1.tgz",
        "@spiky-panda/plugin-dsp": "file:vendor/spiky-panda-plugin-dsp-0.1.1.tgz",
        "@spiky-panda/plugin-geometry": "file:vendor/spiky-panda-plugin-geometry-0.1.1.tgz",
        "@spiky-panda/plugin-harness": "file:vendor/spiky-panda-plugin-harness-0.1.1.tgz",
        "@spiky-panda/plugin-logic": "file:vendor/spiky-panda-plugin-logic-0.1.1.tgz",
        "@spiky-panda/plugin-ml": "file:vendor/spiky-panda-plugin-ml-0.1.1.tgz",
        "@spiky-panda/plugin-onnx": "file:vendor/spiky-panda-plugin-onnx-0.1.1.tgz",
        "@spiky-panda/plugin-physics": "file:vendor/spiky-panda-plugin-physics-0.1.1.tgz",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "@types/qrcode": "^1.5.6",
        "esbuild": "^0.25.12",
        "typescript": "~5.9"
    }
}
