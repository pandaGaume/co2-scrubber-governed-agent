{
  "id": "habitat",
  "title": "The habitat reference: two modules, a centralised scrubber, the inter-module ventilation through its filter, the crew by name",
  "document": "graphs/habitat.spikypanda",
  "parameters": "specs/habitat-parameters.json",
  "variables": {
    "V": {
      "default": 30,
      "min": 10,
      "max": 200,
      "unit": "m3",
      "status": "fitted",
      "source": "the commissioning: the volume the scrubber serves; the design drawing gives 32"
    },
    "Vh": {
      "default": 400,
      "min": 50,
      "max": 1000,
      "unit": "m3",
      "status": "fitted",
      "source": "not documented as built (library station-topology)"
    },
    "L": {
      "default": 0.127,
      "min": 0,
      "max": 0.2,
      "unit": "kg",
      "status": "fitted",
      "source": "what the ventilation delivers, through the filter's loading: 0 is a clean filter at the design flow"
    },
    "g": {
      "default": 0.38,
      "min": 0.26,
      "max": 0.45,
      "unit": "L/min",
      "status": "band",
      "source": "nasa-crew-metabolic-loads: a crewmember awake, 5th to 95th percentile, reference 0.38"
    },
    "gRest": {
      "default": 0.3,
      "unit": "L/min",
      "status": "known",
      "source": "nasa-crew-metabolic-loads: between asleep and awake"
    },
    "Qe": {
      "default": 1,
      "unit": "m3/min",
      "status": "known",
      "source": "scrubber-1-datasheet: effective flow at full command"
    },
    "eta": {
      "default": 0.30303,
      "status": "known",
      "source": "scrubber-1-datasheet: single-pass efficiency"
    },
    "lag": {
      "default": 3.33,
      "unit": "min",
      "status": "known",
      "source": "scrubber-1-datasheet: first-order response"
    }
  },
  "settings": {
    "labOccupants": {
      "default": 2,
      "min": 0,
      "max": 8
    },
    "habOccupants": {
      "default": 2,
      "min": 0,
      "max": 8
    }
  },
  "probes": [
    {
      "node": "co2-1",
      "property": "lastMeasured",
      "unit": "ppm",
      "column": "co2_lab_ppm"
    },
    {
      "node": "co2-2",
      "property": "lastMeasured",
      "unit": "ppm",
      "column": "co2_habb_ppm"
    },
    {
      "node": "lab",
      "property": "ppm_CO2",
      "unit": "ppm"
    },
    {
      "node": "habb",
      "property": "ppm_CO2",
      "unit": "ppm"
    },
    {
      "node": "fan",
      "property": "flowM3PerMinute",
      "unit": "m3/min"
    },
    {
      "node": "filter",
      "property": "clogging"
    },
    {
      "node": "scrubber",
      "property": "flowM3ps",
      "unit": "m3/s"
    },
    {
      "node": "scrubber",
      "property": "removalKgps",
      "unit": "kg/s"
    },
    {
      "node": "hvac",
      "property": "lastVolumetricFlow",
      "unit": "m3/s"
    },
    {
      "node": "crew-lab",
      "property": "co2Delta",
      "unit": "kg/s"
    },
    {
      "node": "crew-habb",
      "property": "co2Delta",
      "unit": "kg/s"
    }
  ],
