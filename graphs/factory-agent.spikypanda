        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-hypothesize",
        "label": "HYPOTHESIZE  the structure and what is fitted",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-build",
        "label": "BUILD  instantiate the graph",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-execute",
        "label": "EXECUTE  fit and run in the sandbox",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-evaluate",
        "label": "EVALUATE  coverage, residual, identifiability",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-pass",
        "label": "PASS  calibration held",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-done",
        "label": "DONE  handed over, validation pending",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-diagnose",
        "label": "DIAGNOSE  why it does not hold",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-parameter",
        "label": "PARAMETER MISMATCH  a fitted value at the edge of its range",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-structural",
        "label": "STRUCTURAL MISMATCH  no admissible set follows the curve",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-invalid",
        "label": "INVALID EVALUATION  a prediction missing, not finite",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-revise",
        "label": "REVISE  the bounds if the physics allows, else the topology",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      },
      {
        "id": "loop-experiment",
        "label": "INSUFFICIENT INFORMATION  plan an experiment",
        "typeId": "Logic.Flow:gate",
        "data": {
          "enabled": true,
          "_startClosed": false
        }
      }
