{
    "title": "The procedure factory's conduct, step by step: its stages, and what it refuses while a stage is not passed (harness/core/conduct.ts)",
    "nodes": [
        { "id": "start", "type": "conduct.start" },

        { "id": "accepted", "type": "conduct.evidence", "bag": { "evidence": "procedureAccepted" } },
        { "id": "installation-read", "type": "conduct.evidence", "bag": { "evidence": "installationRead" } },
        { "id": "method-read", "type": "conduct.evidence", "bag": { "evidence": "methodRead" } },
        { "id": "plan-phase", "type": "conduct.evidence", "bag": { "evidence": "planPhase" } },
        { "id": "signed-norm", "type": "conduct.evidence", "bag": { "evidence": "signedNorm" } },
        { "id": "aborted-before", "type": "conduct.evidence", "bag": { "evidence": "previous" } },
        { "id": "analysis-accepted", "type": "conduct.evidence", "bag": { "evidence": "analysisAccepted" } },

        { "id": "not-accepted", "type": "conduct.not" },
        { "id": "not-installation-read", "type": "conduct.not" },
        { "id": "not-method-read", "type": "conduct.not" },
        { "id": "plan-done", "type": "conduct.not" },
        { "id": "plan-passes", "type": "conduct.any" },
        { "id": "first-test", "type": "conduct.not" },
        { "id": "not-analysed", "type": "conduct.not" },
        { "id": "analysis-passes", "type": "conduct.any" },
        { "id": "analysis-owed", "type": "conduct.all" },

        { "id": "hand-over", "type": "conduct.stage", "bag": { "says": "brief.handOver", "view": "accepted", "order": 6, "goal": "The procedure is accepted: hand it over with task.done, the procedure's file as the artifact.", "tools": ["task.done"] } },
        { "id": "situation", "type": "conduct.stage", "bag": { "says": "brief.situation", "order": 1, "goal": "Read the installation (what is installed, where, what is unknown) and who is in each module.", "tools": ["factory.inventory", "biomed.presence", "biomed.describe"] } },
        { "id": "method", "type": "conduct.stage", "bag": { "says": "brief.method", "view": "method", "order": 2, "goal": "Find the method card that measures the required quantity and read it. A card a person signed is a signed norm: the test plan rests on it.", "tools": ["library.methods", "library.read"] } },
        { "id": "plan", "type": "conduct.stage", "bag": { "says": "brief.plan", "view": "plan", "order": 3, "goal": "Only when the card read is not a signed norm: declare the plan with task.plan. With a signed norm this stage is passed: the norm is the plan.", "tools": ["task.plan"] } },
        { "id": "analysis", "type": "conduct.stage", "bag": { "says": "brief.analysis", "view": "aborted", "order": 4, "goal": "Only after an aborted test: analyse why it stopped with procedure.analyse. Passed when no test was aborted.", "tools": ["procedure.analyse"] } },
        { "id": "procedure", "type": "conduct.stage", "bag": { "says": "brief.procedure", "view": "procedure", "order": 5, "goal": "Write the procedure by the method's rules for this installation, every constant justified (the safety ones by facts of signed documents), and submit it; correct a refusal with procedure.revise.", "tools": ["library.facts", "procedure.submit", "procedure.revise"] } },

        { "id": "plan-needs-installation", "type": "conduct.gate", "bag": { "capabilities": ["task.plan"], "says": "requirements.missing", "vars": { "requirement": "installationRead", "how": { "word": "requirements.installationRead" } } } },
        { "id": "plan-needs-method", "type": "conduct.gate", "bag": { "capabilities": ["task.plan"], "says": "requirements.missing", "vars": { "requirement": "methodRead", "how": { "word": "requirements.methodRead" } } } },
        { "id": "analysis-first", "type": "conduct.gate", "bag": { "capabilities": ["procedure.submit", "procedure.revise"], "says": "analysis.first", "view": "stopped" } },
        { "id": "already-accepted", "type": "conduct.gate", "bag": { "capabilities": ["procedure.submit", "procedure.revise"], "says": "draft.accepted", "view": "accepted" } }
    ],
