{
    "title": "The diagnosis factory's own conduct, step by step (harness/core/conduct.ts): the plan, the diagnosis, the hand-over",
    "nodes": [
        {"id": "start", "type": "conduct.start"},
        {"id": "accepted", "type": "conduct.evidence", "bag": {"evidence": "diagnosisAccepted"}},
