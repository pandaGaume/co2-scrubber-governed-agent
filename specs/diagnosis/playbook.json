        {"id": "hand-over", "type": "conduct.stage", "bag": {"says": "brief.handOver", "view": "accepted", "order": 3, "goal": "The work is accepted: hand it over with task.done, the accepted file as the artifact (kind \"diagnosis\").", "tools": ["task.done"]}},
        {"id": "plan", "type": "conduct.stage", "bag": {"says": "brief.plan", "view": "plan", "order": 1, "goal": "Declare the plan with task.plan: the output missing, to the topic \"diagnosis\" (the work is made here).", "tools": ["task.plan"]}},
        {"id": "diagnose", "type": "conduct.stage", "bag": {"says": "brief.diagnose", "view": "diagnose", "order": 2, "goal": "Read the lead's sources (the graph, the steps, the texts of the contract, the library) and submit the diagnosis with its predictions; after a refusal, submit it whole again, corrected.", "tools": ["diagnosis.graph", "diagnosis.step", "diagnosis.text", "library.read", "library.facts", "diagnosis.submit"]}},
        {"id": "plan-first", "type": "conduct.gate", "bag": {"capabilities": ["diagnosis.submit"], "says": "requirements.missing", "vars": {"requirement": "planDeclared", "how": {"word": "openQuestions.plan"}}}},
        {"id": "already-accepted", "type": "conduct.gate", "bag": {"capabilities": ["diagnosis.submit"], "says": "guard.accepted", "view": "accepted"}}
    ],
    "links": [
