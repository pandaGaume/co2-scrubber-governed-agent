{
    "title": "The Observer's own conduct, step by step (harness/core/conduct.ts): read, the needs, the choice of the facts, the request, the hand-over; and the way out once the attempts are spent",
    "nodes": [
        {
            "id": "start",
            "type": "conduct.start"
        },
        {
            "id": "accepted",
            "type": "conduct.evidence",
            "bag": {
                "evidence": "requestAccepted"
            }
        },
        {
            "id": "read",
            "type": "conduct.evidence",
            "bag": {
                "evidence": "documentRead"
            }
        },
        {
            "id": "attempts-left",
            "type": "conduct.evidence",
            "bag": {
                "evidence": "attemptsLeft"
            }
        },
        {
            "id": "not-accepted",
            "type": "conduct.not"
        },
        {
            "id": "not-read",
            "type": "conduct.not"
        },
        {
            "id": "no-attempt",
            "type": "conduct.not"
        },
        {
            "id": "hand-over",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.handOver",
                "view": "accepted",
                "order": 5,
                "goal": "The request is accepted: hand it over with task.done, the accepted file as the artifact (kind \"request\").",
                "tools": [
                    "task.done"
                ]
            }
        },
        {
            "id": "give-up",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.giveUp",
                "view": "request",
                "exit": true,
                "goal": "No attempt left: end with task.fail, naming the reasons that still stand.",
                "tools": [
                    "task.fail"
                ]
            }
        },
        {
            "id": "reading",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.read",
                "view": "read",
                "order": 1,
                "goal": "Read in the library what the description leaves open: the devices' datasheets, the station's topology and metrics.",
                "tools": [
                    "library.read",
                    "library.facts",
                    "library.search"
                ]
            }
        },
        {
            "id": "listed",
            "type": "conduct.evidence",
            "bag": {
                "evidence": "needsListed"
            }
        },
        {
            "id": "chosen",
            "type": "conduct.evidence",
            "bag": {
                "evidence": "needsChosen"
            }
        },
        {
            "id": "not-listed",
            "type": "conduct.not"
        },
        {
            "id": "not-chosen",
            "type": "conduct.not"
        },
        {
            "id": "needs",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.needs",
                "view": "read",
                "order": 2,
                "goal": "Say what the twin needs as numbers, each in words (observer.needs): the library gives back the facts nearest each.",
                "tools": [
                    "observer.needs"
                ]
            }
        },
        {
            "id": "choose",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.choose",
                "view": "choose",
                "order": 3,
                "goal": "For each need, choose the fact that answers it, or none (observer.choose).",
                "tools": [
                    "observer.choose",
                    "observer.needs",
                    "library.facts",
                    "library.read"
                ]
            }
        },
        {
            "id": "request",
            "type": "conduct.stage",
            "bag": {
                "says": "brief.request",
                "view": "request",
                "order": 4,
                "goal": "Hand over the whole TWIN_FACTORY_REQUEST with observer.submit; after a refusal, send it again, corrected.",
                "tools": [
                    "observer.submit",
                    "library.read",
                    "library.facts",
                    "physics.units_convert"
                ]
            }
        },
        {
            "id": "read-first",
            "type": "conduct.gate",
            "bag": {
                "capabilities": [
                    "observer.needs",
                    "observer.submit"
                ],
                "says": "guard.readFirst"
            }
        },
        {
            "id": "needs-first",
            "type": "conduct.gate",
            "bag": {
                "capabilities": [
                    "observer.choose"
                ],
                "says": "guard.needsFirst"
            }
        },
        {
            "id": "choose-first",
            "type": "conduct.gate",
            "bag": {
                "capabilities": [
                    "observer.submit"
                ],
                "says": "guard.chooseFirst",
                "view": "choose"
            }
        },
        {
            "id": "already-accepted",
            "type": "conduct.gate",
            "bag": {
                "capabilities": [
                    "observer.submit"
                ],
                "says": "guard.accepted",
                "view": "accepted"
            }
        },
        {
            "id": "no-attempt-left",
            "type": "conduct.gate",
            "bag": {
                "capabilities": [
                    "observer.submit"
                ],
                "says": "guard.noAttemptLeft",
                "view": "request"
            }
        }
    ],
